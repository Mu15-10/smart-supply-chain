# Copy to .env and replace every CHANGE_ME value before running Compose.
ENVIRONMENT=development
POSTGRES_DB=supply
POSTGRES_USER=supply
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://supply:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/supply
MONGO_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGO_URL=mongodb://CHANGE_ME_MONGO_USER:CHANGE_ME_MONGO_PASSWORD@mongo:27017/supply_events?authSource=admin
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
JWT_SECRET=CHANGE_ME_32_BYTES_MIN
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated CIDRs for reverse proxies that connect directly to this app.
# Leave empty to ignore X-Forwarded-For. Do not use TRUSTED_PROXY_COUNT.
TRUSTED_PROXY_CIDRS=
LOGIN_MAX_PER_IP=20
LOGIN_MAX_PER_ACCOUNT_IP=5
LOGIN_WINDOW_SECONDS=900
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Public signup defaults on only outside production; set false for invitation-only onboarding.
ALLOW_PUBLIC_REGISTRATION=true
# Return invitation token only in development; production should deliver it by email.
RETURN_INVITATION_TOKEN=true
# GitHub Pages origin must be listed without a path for live deployment.
# ALLOWED_ORIGINS=https://mu15-10.github.io
ALLOWED_HOSTS=localhost,127.0.0.1
DOCS_ENABLED=true
