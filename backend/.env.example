# Copy to .env and replace every CHANGE_ME value before running Compose.
ENVIRONMENT=development
POSTGRES_DB=supply
POSTGRES_USER=supply
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://supply:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/supply
MONGO_URL=mongodb://mongo:27017
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
JWT_SECRET=CHANGE_ME_32_BYTES_MIN
ALLOWED_ORIGINS=http://localhost:5173
TENANT_ID=00000000-0000-0000-0000-000000000001

# Generate a strong JWT secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
